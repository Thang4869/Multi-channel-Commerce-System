{
  "name": "multi-channel-commerce",
  "version": "1.0.0",
  "description": "Multi-channel commerce system with microservices",
  "private": true,
  "workspaces": [
    "services/*",
    "apps/*/*",
    "packages/*",
    "database"
  ],
  "scripts": {
    "install-all": "yarn install",
    "build": "yarn workspaces run build",
    "dev": "yarn workspaces run dev",
    "test": "yarn workspaces run test",
    "lint": "yarn workspaces run lint"
  }
  ,
  "devDependencies": {
    "typescript": "5.3.3"
  },
  "resolutions": {
    "@tsconfig/node10": "npm:@tsconfig/node16@^1.0.2",
    "axios": "^1.16.0",
    "multer": "^2.1.1"
  },
  "overrides": {
    "@tsconfig/node10": "@tsconfig/node16@^1.0.2",
    "axios": "^1.16.0",
    "multer": "^2.1.1"
  },
  "markdownlintConfig": {
    "extends": "./config/.markdownlint.json"
  }
}
